{
  "name": "stepup-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "StepUp on-chain contracts for the Monad chain — SUPToken, RewardDistributor, StepUpSneakers, SupVault, CourseRegistry",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:monad": "hardhat run scripts/deploy-monad.js --network monadTestnet",
    "verify:monad": "hardhat run scripts/verify.js --network monadTestnet",
    "standard-json:monad": "hardhat run scripts/standard-json.js --network monadTestnet",
    "deploy:dry": "hardhat run scripts/deploy.js --network hardhat"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.17",
    "solc": "0.8.29"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-contracts": "1.9.0",
    "@openzeppelin/contracts": "^5.1.0"
  }
}
